<Application x:Class="Lab5.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#222222"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Padding" Value="7"/>
   <Setter Property="BorderBrush" Value="#BBBBBB"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="MinHeight" Value="27"/>
   <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="4,3"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="4,3"/>
   <Setter Property="MaxDropDownHeight" Value="440"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Margin" Value="0,5,0,3"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="15,5"/></Style>
 </Application.Resources>
</Application>
