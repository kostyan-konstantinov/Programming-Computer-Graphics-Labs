<Window x:Class="Lab5.App.BenchmarkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Бенчмарк" Width="1220" Height="720"
 MinWidth="1000" MinHeight="550" Background="White" FontFamily="Segoe UI" FontSize="12" Language="ru-RU" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
   <TextBlock Text="Отрезков:" VerticalAlignment="Center"/>
   <TextBox x:Name="Count" Width="85" Margin="7,0"/>
   <Button x:Name="RunButton" Content="Запустить" Click="Run_Click" Margin="0,0,7,0"/>
   <Button x:Name="OpenButton" Content="Открыть CSV…" Click="Open_Click" Margin="0,0,7,0"/>
   <Button x:Name="SaveButton" Content="Сохранить CSV…" Click="Save_Click" Margin="0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
   <TextBlock x:Name="Source" Text="Результатов ещё нет." TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="State" Text="" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl x:Name="ResultTabs">
   <TabItem Header="Таблица">
    <DataGrid x:Name="Table" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="85"/>
      <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="80"/>
      <DataGridTextColumn Header="Глубина" Binding="{Binding Depth}" Width="60"/>
      <DataGridTextColumn Header="Узлы" Binding="{Binding Nodes}" Width="75"/>
      <DataGridTextColumn Header="Построение, мс" Binding="{Binding Build.Median, StringFormat=F3}" Width="*"/>
      <DataGridTextColumn Header="Отсечение, мс" Binding="{Binding Clip.Median, StringFormat=F3}" Width="*"/>
      <DataGridTextColumn Header="Без дерева, мс" Binding="{Binding Scan.Median, StringFormat=F3}" Width="*"/>
      <DataGridTextColumn Header="Кандидаты" Binding="{Binding Candidates, StringFormat=F1}" Width="85"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Время и глубина"><Viewbox Stretch="Uniform"><Canvas x:Name="DepthPlot" Width="860" Height="460" Background="White"/></Viewbox></TabItem>
   <TabItem Header="Время и плотность"><Viewbox Stretch="Uniform"><Canvas x:Name="DensityPlot" Width="860" Height="460" Background="White"/></Viewbox></TabItem>
   <TabItem Header="Построение"><Viewbox Stretch="Uniform"><Canvas x:Name="BuildPlot" Width="860" Height="460" Background="White"/></Viewbox></TabItem>
   <TabItem Header="Алгоритмы">
    <DataGrid x:Name="Algorithms" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Алгоритм" Binding="{Binding Algorithm}" Width="2*"/>
      <DataGridTextColumn Header="Время, мс" Binding="{Binding Time.Median, StringFormat=F3}" Width="*"/>
      <DataGridTextColumn Header="Умножения" Binding="{Binding Multiply}" Width="*"/>
      <DataGridTextColumn Header="Деления" Binding="{Binding Divide}" Width="*"/>
      <DataGridTextColumn Header="Видимые" Binding="{Binding Visible}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Замеры">
    <DataGrid x:Name="SamplesTable" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Эксперимент" Binding="{Binding Experiment}" Width="*"/>
      <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="2*"/>
      <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="*"/>
      <DataGridTextColumn Header="Глубина" Binding="{Binding Depth}" Width="*"/>
      <DataGridTextColumn Header="Показатель" Binding="{Binding Metric}" Width="*"/>
      <DataGridTextColumn Header="Серия" Binding="{Binding Round}" Width="*"/>
      <DataGridTextColumn Header="Повторов в пакете" Binding="{Binding Iterations}" Width="*"/>
      <DataGridTextColumn Header="Время на операцию, мс" Binding="{Binding Milliseconds, StringFormat=F6}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
